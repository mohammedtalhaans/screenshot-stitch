{
  "name": "screenshot-stitch",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "postinstall": "node scripts/prepare-assets.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "build": "npm run assets && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/test-offline.mjs && playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "test:offline": "node scripts/test-offline.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "audit:runtime": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tesseract.js-data/eng": "1.0.0",
    "@zxing/library": "^0.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compromise": "^14.14.4",
    "fflate": "^0.8.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.12",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-dropzone": "^14.3.8",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
